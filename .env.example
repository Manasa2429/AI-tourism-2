# =========================================================================
# AI Tourism Application - Environment Variables Template
# =========================================================================

# Free OpenWeatherMap Key (for official real-time station temperatures & weather)
# Register free at: https://home.openweathermap.org/users/sign_up
OPENWEATHER_API_KEY=your_openweather_api_key_here
VITE_OPENWEATHER_API_KEY=your_openweather_api_key_here

# Free Unsplash Access Key (for real-time high-resolution photos of any place)
# Register free at: https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here
VITE_UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# Free Google Gemini API Key (for AI itineraries & travel assistant chat)
# Register free at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# MongoDB Connection URI (for Spring Boot backend catalog)
MONGODB_URI=mongodb://localhost:27017/travel_db
