# Frontend API Base URL (defaults to /api proxy in development)
VITE_API_BASE_URL=/api

# Free OpenWeatherMap Key (for official real-time station temperatures & weather conditions)
# Get from: https://home.openweathermap.org/users/sign_up
VITE_OPENWEATHER_API_KEY=your_openweather_api_key_here

# Free Unsplash Access Key (for real-time high-resolution photos of any place)
# Get from: https://unsplash.com/developers
VITE_UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# Free Google Gemini API Key (for AI-powered itineraries & travel assistant chat)
# Get from: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here
